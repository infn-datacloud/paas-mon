# ==============================================================================
# Example .env file for the local test environment
# This file defines all environment variables required by the Docker Compose
# setup for the end-to-end monitoring pipeline:
# Feeder → Kafka → Processor → Telegraf → InfluxDB → Grafana
# ==============================================================================


# ------------------------------------------------------------------------------
# InfluxDB Setup
# ------------------------------------------------------------------------------
DOCKER_INFLUXDB_INIT_USERNAME=admin
DOCKER_INFLUXDB_INIT_PASSWORD=change_me
DOCKER_INFLUXDB_INIT_ORG=INFN
DOCKER_INFLUXDB_INIT_BUCKET=feeder_metrics
DOCKER_INFLUXDB_INIT_RETENTION=0
DOCKER_INFLUXDB_INIT_ADMIN_TOKEN=replace_with_token


# ------------------------------------------------------------------------------
# Grafana Administrator Credentials
# ------------------------------------------------------------------------------
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change_me


# ------------------------------------------------------------------------------
# Telegraf → InfluxDB Authentication
# (usually the same as InfluxDB admin token)
# ------------------------------------------------------------------------------
INFLUX_TOKEN=replace_with_token


# ------------------------------------------------------------------------------
# Kafka (KRaft) Configuration
# ------------------------------------------------------------------------------
KAFKA_CLUSTER_ID=replace_with_cluster_id
KAFKA_NODE_ID=1
KAFKA_INTERNAL_PORT=9092
KAFKA_CONTROLLER_PORT=9093
KAFKA_EXTERNAL_PORT=9095
ADVERTISED_HOST_INTERNAL=kafka-broker
ADVERTISED_HOST_EXTERNAL=localhost
KAFKA_AUTO_CREATE_TOPICS_ENABLE=true
KAFKA_LOG_RETENTION_MS=3456000000
KAFKA_LOG_DIRS=/var/lib/kafka/data


# ------------------------------------------------------------------------------
# Application Configuration
# ------------------------------------------------------------------------------
APP_NAME=monitoring_processor
CLIENT_ID=monitoring_processor
GROUP_ID_BASE=monitoring_processor-
APP_LOG_DIR=/app/logs


# ------------------------------------------------------------------------------
# Kafka Client Settings
# (these values are read by ProviderSelectorConfig)
# ------------------------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=${ADVERTISED_HOST_INTERNAL}:${KAFKA_INTERNAL_PORT}
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_ALLOW_AUTO_CREATE_TOPICS=${KAFKA_AUTO_CREATE_TOPICS_ENABLE}
KAFKA_ACKS=all
KAFKA_ENABLE_IDEMPOTENCE=true
KAFKA_AUTO_OFFSET_RESET=earliest
KAFKA_ENABLE_AUTO_COMMIT=true
KAFKA_FETCH_MAX_BYTES=104857600
KAFKA_MAX_REQUEST_SIZE=104857600
KAFKA_MAX_POLL_RECORDS=1


# ------------------------------------------------------------------------------
# Kafka Topics
# ------------------------------------------------------------------------------
# Use a JSON-like list for multiple input topics, e.g. ["topic1","topic2"]
KAFKA_INPUT_TOPICS=["test_input_topic"]
KAFKA_OUTPUT_TOPIC=test_output_topic
KAFKA_LOG_TOPIC=test_logs_topic


# ------------------------------------------------------------------------------
# Serialization / Deserialization Format
# ------------------------------------------------------------------------------
# Options: json | string
KAFKA_VALUE_SERIALIZER=json
KAFKA_VALUE_DESERIALIZER=json


