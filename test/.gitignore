# =======================================
#  ENVIRONMENT & SENSITIVE FILES
# =======================================
# Ignore real environment files
.env
!.env.example
*.secret
*.key
*.pem
secrets/

# =======================================
#  PYTHON CACHE & LOGS
# =======================================
__pycache__/
*.pyc
*.pyo
*.pyd
*.log
*.tmp

# =======================================
#  SYSTEM / IDE FILES
# =======================================
.vscode/
.idea/
.DS_Store
Thumbs.db

# =======================================
#  TEST DATA & GENERATED FILES
# =======================================
# Ignore all JSON and LP files under test/ and subdirectories
**/*.json
**/*.lp

# Ignore Kafka runtime data and other container-generated files
influxdb-processor/Docker_test/data/kafka/

# Ignore compressed or temporary artifacts
**/*.tar
**/*.gz
**/*.bak
**/*.pid
